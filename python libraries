import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import os

# Create output folder
os.makedirs("output", exist_ok=True)

# Generate sample sales data
np.random.seed(42)

dates = pd.date_range(start="2025-01-01", periods=365, freq="D")

products = ["Laptop", "Phone", "Headphones"]
prices = {"Laptop": 999, "Phone": 699, "Headphones": 149}

data = {
    "date": dates,
    "product": np.random.choice(products, size=365),
    "units_sold": np.random.randint(5, 50, size=365)
}

df = pd.DataFrame(data)

# Add product price and calculate revenue
df["price"] = df["product"].map(prices)
df["revenue"] = df["units_sold"] * df["price"]

# Save dataset
df.to_csv("output/sales_data.csv", index=False)

# Monthly revenue analysis
df["month"] = df["date"].dt.to_period("M")
monthly_revenue = df.groupby("month")["revenue"].sum()

# Plot monthly revenue
plt.figure(figsize=(12, 6))
monthly_revenue.plot(kind="bar", color="skyblue")
plt.title("Monthly Sales Revenue")
plt.xlabel("Month")
plt.ylabel("Revenue ($)")
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig("output/monthly_revenue.png")
plt.show()

# Revenue by product
product_revenue = df.groupby("product")["revenue"].sum().sort_values(ascending=False)

plt.figure(figsize=(8, 5))
product_revenue.plot(kind="bar", color="teal")
plt.title("Revenue by Product")
plt.xlabel("Product")
plt.ylabel("Revenue ($)")
plt.tight_layout()
plt.savefig("output/revenue_by_product.png")
plt.show()

# Print summary
print("Sales Data Summary")
print("------------------")
print(df.head())
print("\nTotal revenue:", df["revenue"].sum())
print("\nRevenue by product:")
print(product_revenue)
print("\nBest selling product by revenue:")
print(product_revenue.idxmax())
